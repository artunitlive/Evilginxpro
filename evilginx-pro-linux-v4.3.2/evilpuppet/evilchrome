#!/bin/bash -e

#trap 'if [[ ! $? -eq 0 ]]; then echo "error: $?" fi' EXIT

EVILCHROME_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

is_root () {
    return $(id -u)
}

get_distro_name() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        echo "$ID"
    else
        echo "unknown"
    fi
}

install() {
    if ! is_root; then
        echo "error: install needs to be ran as root!"
        exit 1
    fi

    LIBASOUND2_PKG="libasound2"
    OS_NAME=$(get_distro_name)

    if [[ "$OS_NAME" = "ubuntu" ]]; then
        LIBASOUND2_PKG="libasound2-dev"
    fi

    sudo apt-get update
    sudo apt -yqq --fix-broken install
    sudo DEBIAN_FRONTEND=noninteractive apt-get -yqq install xorg xvfb curl ca-certificates fonts-liberation $LIBASOUND2_PKG libatk-bridge2.0-0 libatk1.0-0 libc6 libcairo2 libcups2 libdbus-1-3 libexpat1 libfontconfig1 libgbm1 libgcc1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 libpangocairo-1.0-0 libstdc++6 libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxcursor1 libxdamage1 libxext6 libxfixes3 libxi6 libxrandr2 libxrender1 libxss1 libxtst6 lsb-release wget xdg-utils
    sudo sysctl -w kernel.unprivileged_userns_clone=1

    if [[ -z $(command -v google-chrome) ]]; then
        curl -o google-chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
        dpkg -i google-chrome.deb
    fi
}

run() {
    if is_root; then
        echo "error: run this script as a normal user, not as root!"
        exit 1
    fi

    export DISPLAY=:99
    if [[ -z $(pidof "Xvfb") ]]; then
        echo "launching: Xvfb"
        Xvfb -ac :99 -screen 0 1280x1024x16 &>/dev/null & disown
    fi

    /usr/bin/google-chrome --allow-pre-commit-input --disable-background-networking --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-breakpad --disable-client-side-phishing-detection --disable-component-update --disable-dev-shm-usage --disable-hang-monitor --disable-infobars --disable-ipc-flooding-protection --disable-popup-blocking --disable-prompt-on-repost --disable-renderer-backgrounding --disable-search-engine-choice-screen --disable-sync --enable-automation --export-tagged-pdf --generate-pdf-document-outline --force-color-profile=srgb --metrics-recording-only --no-first-run --password-store=basic --use-mock-keychain --disable-features=Translate,AcceptCHFrame,MediaRouter,OptimizationHints,ProcessPerSiteUpToMainFrameThreshold,IsolateSandboxedIframes --enable-features=PdfOopif --user-data-dir=~/evilchrome about:blank --disable-blink-features=AutomationControlled --remote-debugging-port=58000
}

if [[ $# -eq 0 ]]; then
    echo "usage: $0 <install|run>"
    exit 1
fi

COMMAND=$1

case $COMMAND in
    "install")
        install
        ;;

    "run")
        run
        ;;

    *)
        echo "error: unknown command: $COMMAND"
        ;;
esac
